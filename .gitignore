data/hard_negatives.jsonl

# Trained weights and checkpoints. Keep model cards, tokenizer files, and
# configuration metadata tracked; publish large weights externally.
models/**/checkpoints/
models/**/*.safetensors
models/**/*.bin
models/**/*.pt
models/**/*.pth

# Experiment outputs; curated report evidence is tracked.
results/*
!results/.gitkeep
!results/published/
!results/published/**

